---
import { t } from '../i18n/ui';
import { SITE } from '../i18n/site';
import type { Locale } from '../lib/content';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const channels = [
  {
    icon: '✉️',
    title: t(lang, 'contact.email'),
    value: SITE.email,
    href: `mailto:${SITE.email}`,
  },
  {
    icon: '💼',
    title: t(lang, 'contact.linkedin'),
    value: 'linkedin.com/in/jiaqi-wang-cloud',
    href: SITE.linkedin,
  },
  {
    icon: '🐙',
    title: t(lang, 'contact.github'),
    value: 'github.com/jiaqi-wang-cloud',
    href: SITE.github,
  },
  {
    icon: '📄',
    title: t(lang, 'contact.resume'),
    value: t(lang, 'contact.resume'),
    href: SITE.resumeUrl,
  },
];
---

<section class="page-head">
  <div class="container">
    <div class="kicker reveal">{t(lang, 'contact.kicker')}</div>
    <h1 class="reveal" style="--d:1">{t(lang, 'contact.title')}</h1>
    <p class="lead reveal" style="--d:2" style="max-width: 60ch;">{t(lang, 'contact.sub')}</p>
  </div>
</section>

<section class="section" style="padding-top: 40px;">
  <div class="container">
    <div class="info-strip reveal">
      <div>
        <span class="m-label">{t(lang, 'contact.location')}</span>
        <span class="info-value">📍 {SITE.location}</span>
      </div>
      <div>
        <span class="m-label">{t(lang, 'contact.availability')}</span>
        <span class="info-value ok">● {t(lang, 'contact.available')}</span>
      </div>
      <div>
        <span class="m-label">Languages</span>
        <span class="info-value">English · Français · 中文</span>
      </div>
    </div>

    <div class="contact-grid">
      {channels.map((c, i) => (
        <a class="contact-card" href={c.href} target={c.href.startsWith('http') ? '_blank' : undefined} rel="noopener" style={`--d:${i}`}>
          <span class="c-icon">{c.icon}</span>
          <span>
            <strong>{c.title}</strong>
            <small>{c.value}</small>
          </span>
          <span class="arrow">→</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .info-strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 12px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--panel);
    padding: 20px 24px;
    margin-bottom: 28px;
  }
  .m-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--txt-3);
    margin-bottom: 6px;
  }
  .info-value {
    font-size: 15px;
    color: var(--txt);
  }
  .info-value.ok {
    color: var(--ok);
  }
  .contact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
  }
  .contact-card {
    display: flex;
    align-items: center;
    gap: 16px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: linear-gradient(180deg, var(--panel-2), var(--panel));
    padding: 22px 24px;
    transition: transform 0.25s var(--ease), border-color 0.25s, box-shadow 0.25s;
  }
  .contact-card:hover {
    transform: translateY(-3px);
    border-color: var(--line-strong);
    box-shadow: 0 14px 40px -18px rgba(141, 123, 255, 0.45);
  }
  .c-icon {
    font-size: 24px;
    filter: grayscale(0.15);
  }
  .contact-card strong {
    display: block;
    font-size: 16px;
    margin-bottom: 3px;
  }
  .contact-card small {
    color: var(--txt-3);
    font-size: 13px;
    font-family: var(--font-mono);
    word-break: break-all;
  }
  .contact-card .arrow {
    margin-left: auto;
    color: var(--brand-2);
  }
</style>
