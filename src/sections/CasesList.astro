---
import { t } from '../i18n/ui';
import { getEntries, type Locale } from '../lib/content';
import CaseCard from '../components/CaseCard.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const cases = (await getEntries('cases', lang)).sort(
  (a, b) => b.data.order - a.data.order || b.data.year.localeCompare(a.data.year)
);
---

<section class="page-head">
  <div class="container">
    <div class="kicker reveal">{t(lang, 'cases.kicker')}</div>
    <h1 class="reveal" style="--d:1">{t(lang, 'cases.title')}</h1>
    <p class="lead reveal" style="--d:2">{t(lang, 'cases.sub')}</p>
  </div>
</section>

<section class="section" style="padding-top: 40px;">
  <div class="container">
    {
      cases.length > 0 ? (
        <div class="card-grid">
          {cases.map((c) => (
            <CaseCard
              lang={lang}
              slug={c.slug}
              title={c.data.title}
              client={c.data.client}
              sector={c.data.sector}
              duration={c.data.duration}
              year={c.data.year}
              summary={c.data.summary}
              impact={c.data.impact}
              tags={c.data.tags}
              featured={c.data.featured}
              template={c.data.template}
            />
          ))}
        </div>
      ) : (
        <div class="empty-note">
          <p>{t(lang, 'cases.templateHint')}</p>
        </div>
      )
    }
  </div>
</section>
