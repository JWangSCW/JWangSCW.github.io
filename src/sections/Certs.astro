---
import { t, type UIKey } from '../i18n/ui';
import { getEntries, type Locale } from '../lib/content';
import SectionHead from '../components/SectionHead.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const groups: Array<{ id: 'cloud' | 'strategy' | 'data' | 'other'; labelKey: UIKey }> = [
  { id: 'cloud', labelKey: 'certs.cloud' },
  { id: 'strategy', labelKey: 'certs.strategy' },
  { id: 'data', labelKey: 'certs.data' },
  { id: 'other', labelKey: 'certs.other' },
];

const all = (await getEntries('certs', lang))
  .filter((c) => (import.meta.env.PROD ? !c.data.draft : true))
  .sort((a, b) => b.data.order - a.data.order || b.data.issued.localeCompare(a.data.issued));
---

<section class="page-head">
  <div class="container">
    <div class="kicker reveal">{t(lang, 'certs.kicker')}</div>
    <h1 class="reveal" style="--d:1">{t(lang, 'certs.title')}</h1>
    <p class="lead reveal" style="--d:2">{t(lang, 'certs.sub')}</p>
  </div>
</section>

<section class="section" style="padding-top: 40px;">
  <div class="container">
    {
      groups.map((group) => {
        const items = all.filter((c) => c.data.group === group.id);
        if (items.length === 0) return null;
        return (
          <div>
            <h2 class="cert-group-title">{t(lang, group.labelKey)}</h2>
            <div class="cert-grid">
              {items.map((c) => (
                <div class:list={{ cert: true, draft: c.data.draft }}>
                  <div class="issuer">{c.data.issuer}</div>
                  <div class="title">{c.data.title}</div>
                  <div class="when">
                    {t(lang, 'certs.issued')} {c.data.issued}
                    {c.data.credentialId && ` · ID ${c.data.credentialId}`}
                  </div>
                  {
                    c.data.credentialUrl ? (
                      <a class="verify" href={c.data.credentialUrl} target="_blank" rel="noopener">
                        {t(lang, 'certs.verify')} <span class="arrow">↗</span>
                      </a>
                    ) : (
                      c.data.draft && <div class="when" style="color: var(--warn);">{t(lang, 'certs.draftNote')}</div>
                    )
                  }
                </div>
              ))}
            </div>
          </div>
        );
      })
    }
  </div>
</section>
