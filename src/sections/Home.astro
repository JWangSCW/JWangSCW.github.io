---
import { t } from '../i18n/ui';
import { SITE } from '../i18n/site';
import { getEntries, type Locale } from '../lib/content';
import Terminal from '../components/Terminal.astro';
import CaseCard from '../components/CaseCard.astro';
import PostRow from '../components/PostRow.astro';
import SectionHead from '../components/SectionHead.astro';

interface Props {
  lang: Locale;
  title: string;
  description: string;
}

const { lang } = Astro.props;

const page = (path: string) => (lang === 'en' ? path : `/fr${path}`);

const cases = (await getEntries('cases', lang)).sort(
  (a, b) => b.data.order - a.data.order || b.data.year.localeCompare(a.data.year)
);

const featuredCases = cases
  .filter((c) => c.data.featured)
  .slice(0, 2);
const displayCases = featuredCases.length ? featuredCases : cases.slice(0, 2);

const posts = (await getEntries('posts', lang))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

const certs = (await getEntries('certs', lang))
  .filter((c) => !c.data.draft)
  .sort((a, b) => b.data.order - a.data.order || b.data.issued.localeCompare(a.data.issued));
const certIssuers = [...new Set(certs.map((c) => c.data.issuer))].slice(0, 8);
---

<section class="hero">
  <div class="container">
    <div class="hero-grid">
      <div>
        <div class="hero-status reveal"><span class="dot"></span>{t(lang, 'hero.status')}</div>
        <div class="kicker reveal" style="--d:1">{t(lang, 'hero.kicker')}</div>
        <h1 class="reveal" style="--d:2">
          {t(lang, 'hero.title1')} <span class="grad">{t(lang, 'hero.title2')}</span>
          <br />
          {t(lang, 'hero.title3')}
        </h1>
        <p class="lead reveal" style="--d:3">{t(lang, 'hero.lead')}</p>
        <div class="hero-actions reveal" style="--d:4">
          <a class="btn btn--primary" href={page('/cases/')}>
            {t(lang, 'hero.cta.cases')} <span class="arrow">→</span>
          </a>
          <a class="btn btn--ghost" href={SITE.resumeUrl}>
            {t(lang, 'hero.cta.resume')}
          </a>
        </div>
        <div class="provider-strip reveal" style="--d:5">
          <span class="label">{t(lang, 'hero.providers')}</span>
          {SITE.providers.map((p) => <span class="chip">{p}</span>)}
        </div>
      </div>

      <div class="reveal" style="--d:3">
        <Terminal lang={lang} />
      </div>
    </div>

    <div class="metrics reveal" style="--d:4">
      <div class="metric">
        <span class="v">{t(lang, 'metric.years.v')}</span>
        <span class="l">{t(lang, 'metric.years.l')}</span>
      </div>
      <div class="metric">
        <span class="v">{t(lang, 'metric.impact.v')}</span>
        <span class="l">{t(lang, 'metric.impact.l')}</span>
      </div>
      <div class="metric">
        <span class="v">{t(lang, 'metric.sovereignty.v')}</span>
        <span class="l">{t(lang, 'metric.sovereignty.l')}</span>
      </div>
      <div class="metric">
        <span class="v">{t(lang, 'metric.langs.v')}</span>
        <span class="l">{t(lang, 'metric.langs.l')}</span>
      </div>
    </div>
  </div>
</section>

{
  displayCases.length > 0 && (
    <section class="section">
      <div class="container">
        <SectionHead lang={lang} kickerKey="home.cases.kicker" titleKey="home.cases.title" subKey="home.cases.sub" />
        <div class="card-grid">
          {displayCases.map((c) => (
            <CaseCard
              lang={lang}
              slug={c.slug}
              title={c.data.title}
              client={c.data.client}
              sector={c.data.sector}
              duration={c.data.duration}
              year={c.data.year}
              summary={c.data.summary}
              impact={c.data.impact}
              tags={c.data.tags}
              featured={c.data.featured}
              template={c.data.template}
            />
          ))}
        </div>
        <div style="margin-top: 30px;">
          <a class="btn btn--ghost" href={page('/cases/')}>
            {t(lang, 'home.cases.all')} <span class="arrow">→</span>
          </a>
        </div>
      </div>
    </section>
  )
}

{
  posts.length > 0 && (
    <section class="section section--alt">
      <div class="container">
        <SectionHead lang={lang} kickerKey="home.writing.kicker" titleKey="home.writing.title" subKey="home.writing.sub" />
        {posts.map((p) => (
          <PostRow
            lang={lang}
            slug={p.slug}
            title={p.data.title}
            description={p.data.description}
            pubDate={p.data.pubDate}
            tags={p.data.tags}
            body={p.body}
          />
        ))}
        <div style="margin-top: 30px;">
          <a class="btn btn--ghost" href={page('/writing/')}>
            {t(lang, 'home.writing.all')} <span class="arrow">→</span>
          </a>
        </div>
      </div>
    </section>
  )
}

{
  certIssuers.length > 0 && (
    <section class="section" style="padding-block: 60px;">
      <div class="container">
        <SectionHead lang={lang} kickerKey="home.certs.kicker" titleKey="home.certs.title" subKey="home.certs.sub" />
        <div class="provider-strip" style="margin-bottom: 26px;">
          {certIssuers.map((issuer) => <span class="chip chip--brand">{issuer}</span>)}
        </div>
        <a class="btn btn--ghost" href={page('/certs/')}>
          {t(lang, 'home.certs.all')} <span class="arrow">→</span>
        </a>
      </div>
    </section>
  )
}

<section class="section" style="padding-top: 20px;">
  <div class="container">
    <div class="cta-banner reveal">
      <h2>{t(lang, 'home.cta.title')}</h2>
      <p>{t(lang, 'home.cta.sub')}</p>
      <a class="btn btn--primary" href={page('/contact/')}>
        {t(lang, 'home.cta.btn')} <span class="arrow">→</span>
      </a>
    </div>
  </div>
</section>
