---
import { render } from 'astro:content';
import { t } from '../i18n/ui';
import { getEntries, type Locale } from '../lib/content';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'posts'> & { slug: string };
  lang: Locale;
}

const { entry, lang } = Astro.props;
const { Content } = await render(entry);
const page = (path: string) => (lang === 'en' ? path : `/fr${path}`);
const minutes = Math.max(1, Math.round(entry.body.trim().split(/\s+/).length / 220));
const dateLabel = entry.data.pubDate.toLocaleDateString(lang === 'en' ? 'en-GB' : 'fr-FR', {
  year: 'numeric',
  month: 'long',
  day: '2-digit',
});

const siblings = (await getEntries('posts', lang))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const idx = siblings.findIndex((c) => c.slug === entry.slug);
const next = idx === -1 ? undefined : siblings[(idx + 1) % siblings.length];
---

<section class="page-head">
  <div class="container">
    <nav class="breadcrumb">
      <a href={page('/writing/')}>← {t(lang, 'writing.back')}</a>
    </nav>
    <div class="kicker reveal" style="margin-top: 22px;">{dateLabel} · {minutes} {t(lang, 'writing.min')}</div>
    <h1 class="reveal" style="--d:1">{entry.data.title}</h1>
    <p class="lead reveal" style="--d:2">{entry.data.description}</p>
    <div class="card-foot" style="margin-top: 18px;">
      {entry.data.tags.map((s) => <span class="chip">{s}</span>)}
    </div>
  </div>
</section>

<section class="section" style="padding-top: 36px;">
  <div class="container">
    <div class="article">
      <div class="article-content reveal">
        <Content />
      </div>
    </div>

    {
      next && (
        <nav class="next-case">
          <a href={page(`/writing/${next.slug}/`)}>
            <span class="m-label">{t(lang, 'cases.next')}</span>
            <strong>{next.data.title} <span class="arrow">→</span></strong>
          </a>
        </nav>
      )
    }
  </div>
</section>

<style>
  .breadcrumb a {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--txt-2);
  }
  .breadcrumb a:hover {
    color: var(--brand-2);
  }
  .m-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--txt-3);
    margin-bottom: 4px;
  }
  .next-case {
    margin-top: 60px;
    border-top: 1px solid var(--line);
    padding-top: 26px;
    display: grid;
    gap: 6px;
  }
  .next-case a {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .next-case strong {
    font-size: 19px;
  }
  .next-case:hover strong {
    color: var(--brand-2);
  }
</style>
