---
import { t } from '../i18n/ui';
import { education, experience } from '../i18n/experience';
import type { Locale } from '../lib/content';
import SectionHead from '../components/SectionHead.astro';

interface Props {
  lang: Locale;
  title: string;
  description: string;
}

const { lang } = Astro.props;
const items = experience[lang];
const edu = education[lang];
---

<section class="page-head">
  <div class="container">
    <div class="kicker reveal">{t(lang, 'exp.kicker')}</div>
    <h1 class="reveal" style="--d:1">{t(lang, 'exp.title')}</h1>
    <p class="lead reveal" style="--d:2">{t(lang, 'exp.sub')}</p>
  </div>
</section>

<section class="section" style="padding-top: 40px;">
  <div class="container">
    <div class="timeline">
      {
        items.map((item, i) => (
          <div class:list={{ 't-item': true, current: item.current }} style={`--d:${i}`}>
            <div class="t-when">{item.when}</div>
            <h3>{item.role}</h3>
            <div class="t-org">{item.org}</div>
            <ul>
              {item.bullets.map((b) => <li>{b}</li>)}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<section class="section section--alt" style="padding-top: 20px;">
  <div class="container">
    <SectionHead lang={lang} kickerKey="edu.kicker" titleKey="edu.title" subKey="edu.sub" />
    <div class="cert-grid">
      {
        edu.map((e) => (
          <div class="cert">
            <div class="issuer">{e.school}</div>
            <div class="title">{e.degree}</div>
            <div class="when">{e.when}</div>
            <p style="font-size: 14px; color: var(--txt-2); line-height: 1.65; margin-top: 2px;">{e.details}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
