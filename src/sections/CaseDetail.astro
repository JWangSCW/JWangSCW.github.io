---
import { render } from 'astro:content';
import { t } from '../i18n/ui';
import { getEntries, type Locale } from '../lib/content';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'cases'> & { slug: string };
  lang: Locale;
}

const { entry, lang } = Astro.props;
const { Content } = await render(entry);
const page = (path: string) => (lang === 'en' ? path : `/fr${path}`);

const siblings = (await getEntries('cases', lang)).sort(
  (a, b) => b.data.order - a.data.order || b.data.year.localeCompare(a.data.year)
);
const idx = siblings.findIndex((c) => c.slug === entry.slug);
const next = idx === -1 ? undefined : siblings[(idx + 1) % siblings.length];
---

<section class="page-head">
  <div class="container">
    <nav class="breadcrumb">
      <a href={page('/cases/')}>← {t(lang, 'cases.back')}</a>
    </nav>
    <div class="kicker reveal" style="margin-top: 22px;">
      {entry.data.sector} · {entry.data.year} · {entry.data.duration}
    </div>
    {
      entry.data.template && (
        <div class="template-ribbon">
          ⚠️ {t(lang, 'cases.template')} — {t(lang, 'cases.templateHint')}
        </div>
      )
    }
    <h1 class="reveal" style="--d:1">{entry.data.title}</h1>
    <p class="lead reveal" style="--d:2">{entry.data.summary}</p>
  </div>
</section>

<section class="section" style="padding-top: 36px;">
  <div class="container">
    <div class="article-meta reveal" style="--d:2">
      <div class="impact-box" style="font-size: 15px;">{t(lang, 'cases.impact')} — {entry.data.impact}</div>
      <div class="meta-grid">
        <div><span class="m-label">{t(lang, 'cases.meta.client')}</span>{entry.data.client}</div>
        <div><span class="m-label">{t(lang, 'cases.meta.role')}</span>{entry.data.role}</div>
        <div><span class="m-label">{t(lang, 'cases.meta.stack')}</span>{entry.data.stack.join(' · ')}</div>
        <div><span class="m-label">{t(lang, 'cases.meta.tags')}</span>{entry.data.tags.join(' · ')}</div>
      </div>
    </div>

    <div class="article">
      <div class="article-content reveal" style="--d:3">
        <Content />
      </div>
    </div>

    {
      next && (
        <nav class="next-case">
          <a href={page(`/cases/${next.slug}/`)}>
            <span class="m-label">{t(lang, 'cases.next')}</span>
            <strong>{next.data.title} <span class="arrow">→</span></strong>
          </a>
        </nav>
      )
    }
  </div>
</section>

<style>
  .breadcrumb a {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--txt-2);
  }
  .breadcrumb a:hover {
    color: var(--brand-2);
  }
  .template-ribbon {
    margin: 18px 0 6px;
    font-size: 13.5px;
    color: var(--warn);
    border: 1px dashed rgba(251, 191, 36, 0.4);
    background: rgba(251, 191, 36, 0.06);
    border-radius: 10px;
    padding: 10px 14px;
  }
  .article-meta {
    display: grid;
    gap: 18px;
    margin-bottom: 44px;
  }
  .meta-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 12px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--panel);
    padding: 20px 22px;
    font-size: 14.5px;
    color: var(--txt-2);
  }
  .m-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--txt-3);
    margin-bottom: 4px;
  }
  .next-case {
    margin-top: 60px;
    border-top: 1px solid var(--line);
    padding-top: 26px;
    display: grid;
    gap: 6px;
  }
  .next-case a {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .next-case strong {
    font-size: 19px;
  }
  .next-case:hover strong {
    color: var(--brand-2);
  }
</style>
