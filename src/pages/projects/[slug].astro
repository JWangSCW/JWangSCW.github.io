---
import Base from '../../layouts/Base.astro';
import ProjectDetail from '../../sections/ProjectDetail.astro';
import { getEntries } from '../../lib/content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getEntries('projects', 'en');
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry: entry as CollectionEntry<'projects'> },
  }));
}

const { entry } = Astro.props;
---

<Base title={entry.data.title} description={entry.data.description} lang="en">
  <ProjectDetail entry={entry} lang="en" />
</Base>
