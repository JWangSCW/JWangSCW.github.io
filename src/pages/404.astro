---
import Base from '../layouts/Base.astro';
import { t } from '../i18n/ui';
const lang = 'en';
---

<Base title={t(lang, '404.title')} description={t(lang, '404.sub')} lang={lang}>
  <section class="page-head" style="padding-block: 120px; text-align: center;">
    <div class="container">
      <div class="kicker" style="justify-content: center;">404</div>
      <h1>{t(lang, '404.title')}</h1>
      <p class="lead" style="margin: 18px auto 30px;">{t(lang, '404.sub')}</p>
      <a class="btn btn--primary" href="/">← {t(lang, '404.home')}</a>
    </div>
  </section>
</Base>
