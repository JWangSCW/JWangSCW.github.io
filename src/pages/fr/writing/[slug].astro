---
import Base from '../../../layouts/Base.astro';
import PostDetail from '../../../sections/PostDetail.astro';
import { getEntries } from '../../../lib/content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getEntries('posts', 'fr');
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry: entry as CollectionEntry<'posts'> },
  }));
}

const { entry } = Astro.props;
---

<Base title={entry.data.title} description={entry.data.description} lang="fr">
  <PostDetail entry={entry} lang="fr" />
</Base>
